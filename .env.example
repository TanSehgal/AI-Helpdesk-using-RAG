# --- LLM provider ---
# "ollama" for local inference, "cloud" for an OpenAI-compatible API
LLM_PROVIDER=ollama

# Local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM settings (only used when LLM_PROVIDER=cloud)
# Never commit real API keys. This is a placeholder only.
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=gpt-4o-mini

# --- RAG settings ---
CHROMA_PERSIST_DIRECTORY=./data/chroma
KNOWLEDGE_BASE_DIR=./knowledge_base
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=4

# --- API settings ---
API_HOST=0.0.0.0
API_PORT=8000
